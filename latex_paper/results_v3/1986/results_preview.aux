\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Pooled panel: 153 factors and the market series. July 2006--December 2024. Metrics use log realized variance and are read from eval\_metrics. R-squared uses the evaluation-sample mean, not HAR. Bias is target minus forecast. EW averages the seven HARX/ML log forecasts with weight 1/7 each.}}{2}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:rv-performance_panel}{{1}{2}{Pooled panel: 153 factors and the market series. July 2006--December 2024. Metrics use log realized variance and are read from eval\_metrics. R-squared uses the evaluation-sample mean, not HAR. Bias is target minus forecast. EW averages the seven HARX/ML log forecasts with weight 1/7 each}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Standalone market series (\_spx; source index universe unverified). July 2006--December 2024. Metrics use log realized variance and are read from eval\_metrics. R-squared uses the evaluation-sample mean, not HAR. Bias is target minus forecast. EW averages the seven HARX/ML log forecasts with weight 1/7 each.}}{2}{table.caption.3}\protected@file@percent }
\newlabel{tab:rv-performance_spx}{{2}{2}{Standalone market series (\_spx; source index universe unverified). July 2006--December 2024. Metrics use log realized variance and are read from eval\_metrics. R-squared uses the evaluation-sample mean, not HAR. Bias is target minus forecast. EW averages the seven HARX/ML log forecasts with weight 1/7 each}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Distribution of per-factor RMSE reductions relative to HAR. Positive values indicate improvement. Excludes the market key; no significance claims.}}{3}{table.caption.4}\protected@file@percent }
\newlabel{tab:rv-factor_gain_summary}{{3}{3}{Distribution of per-factor RMSE reductions relative to HAR. Positive values indicate improvement. Excludes the market key; no significance claims}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Sequential RMSE reductions: HAR to HARX, HARX to each learner, then learner to the same seven-model EW ensemble. Positive values indicate improvement. Differences telescope arithmetically; they are not a causal attribution. ENET adds shrinkage, not nonlinearities.}}{3}{table.caption.5}\protected@file@percent }
\newlabel{tab:rv-sequential_comparisons}{{4}{3}{Sequential RMSE reductions: HAR to HARX, HARX to each learner, then learner to the same seven-model EW ensemble. Positive values indicate improvement. Differences telescope arithmetically; they are not a causal attribution. ENET adds shrinkage, not nonlinearities}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Predictive RMSE reductions relative to HAR, distinguishing aggregate panel, factors only, standalone market and market from pooled estimation. Negative values are deterioration. No model is selected ex post as the nonlinear representative.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rv-har_relative_gains}{{1}{3}{Predictive RMSE reductions relative to HAR, distinguishing aggregate panel, factors only, standalone market and market from pooled estimation. Negative values are deterioration. No model is selected ex post as the nonlinear representative}{figure.caption.6}{}}
