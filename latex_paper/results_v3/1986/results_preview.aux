\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Trailing 12-month RMSE. Squared errors are pooled across all target-month observations in each window before taking the square root. Incomplete starting windows are omitted. Market-only monthly RMSE would be absolute error.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:rv-rolling_rmse}{{2}{5}{Trailing 12-month RMSE. Squared errors are pooled across all target-month observations in each window before taking the square root. Incomplete starting windows are omitted. Market-only monthly RMSE would be absolute error}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Selected validation RMSE versus the subsequent test block. Validation windows contain 90 overlapping months; test blocks normally contain 12 months, with partial first/last blocks. NN validation scores one network; test forecasts average ten refitted networks. Differences also reflect refitting and changing market conditions.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:rv-validation_test}{{3}{5}{Selected validation RMSE versus the subsequent test block. Validation windows contain 90 overlapping months; test blocks normally contain 12 months, with partial first/last blocks. NN validation scores one network; test forecasts average ten refitted networks. Differences also reflect refitting and changing market conditions}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Final-refit gross\_share by predictor theme. Descriptive OLS surrogate loadings, not causal effects or permutation importance. The intercept is excluded. Each coefficient is divided by the sum of absolute non-intercept coefficients. Gross shares sum absolute loadings within themes; net shares retain signs. Aliases are zero under the stored parameterization, not evidence of irrelevance; predictor scales differ. Own-series terms refer to each factor's returns, not S\&P 500 returns. EW has no fitted surrogate.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:rv-final_theme_gross_share}{{4}{6}{Final-refit gross\_share by predictor theme. Descriptive OLS surrogate loadings, not causal effects or permutation importance. The intercept is excluded. Each coefficient is divided by the sum of absolute non-intercept coefficients. Gross shares sum absolute loadings within themes; net shares retain signs. Aliases are zero under the stored parameterization, not evidence of irrelevance; predictor scales differ. Own-series terms refer to each factor's returns, not S\&P 500 returns. EW has no fitted surrogate}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Final-refit net\_share by predictor theme. Descriptive OLS surrogate loadings, not causal effects or permutation importance. The intercept is excluded. Each coefficient is divided by the sum of absolute non-intercept coefficients. Gross shares sum absolute loadings within themes; net shares retain signs. Aliases are zero under the stored parameterization, not evidence of irrelevance; predictor scales differ. Own-series terms refer to each factor's returns, not S\&P 500 returns. EW has no fitted surrogate.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:rv-final_theme_net_share}{{5}{7}{Final-refit net\_share by predictor theme. Descriptive OLS surrogate loadings, not causal effects or permutation importance. The intercept is excluded. Each coefficient is divided by the sum of absolute non-intercept coefficients. Gross shares sum absolute loadings within themes; net shares retain signs. Aliases are zero under the stored parameterization, not evidence of irrelevance; predictor scales differ. Own-series terms refer to each factor's returns, not S\&P 500 returns. EW has no fitted surrogate}{figure.caption.11}{}}
