.Rproj.user
.Rhistory
.Rdata
Rplots.pdf
.httr-oauth
.DS_Store
.quarto
tmp/

# Raw JKP daily factor returns (~225 MB). Kept out of history on purpose; its
# SHA-256 is recorded in data/manifest_v3.csv so provenance stays verifiable.
# Brackets are escaped because gitignore reads [...] as a character class.
data/\[usa\]_\[all_factors\]_\[daily\]_\[vw_cap\].csv

# AQR's daily BAB workbook (~31 MB), same policy: untracked, hashed in
# data/manifest_demiguel_v3.csv. The small provider files stay tracked.
data/demiguel/raw/Betting-Against-Beta-Equity-Factors-Daily.xlsx

# Stock-level data from the DeMiguel et al. (2024) replication package
# (~476 MB; Mendeley Data, DOI 10.17632/dmjfztbc4y.3). Untracked; its SHA-256
# and the package's are recorded in data/manifest_demiguel_costs_v3.csv.
data/demiguel/raw/MainDataRep.mat

# Fitted backtest objects (~1.2 GB). Regenerated by R/fit_models.R, and each one
# carries its own provenance record, so the history gains nothing by storing
# the bytes.
models_v3/

# Covariate diagnostics, regenerated by R/plot_variables.R
diagnostics_v3/

# Generated datasets (~70 MB), built by R/load_data.R. Their SHA-256 is
# recorded in data/manifest_v3.csv, which IS tracked, so a fitted model can
# still be traced back to the exact bytes it read.
data/*_v3.rds

# Exploratory figure renders written to the project root
fig_*.png

# Stale root renders of the covariate summaries. R/plot_variables.R writes the
# current ones to diagnostics_v3/; these are leftovers from before it was
# redirected there.
summary_*.html

# Interactive result dumps from the v2 workflow. No script in the repo writes
# or reads them.
results_summary_*.csv

# LaTeX build artifacts. The manuscript sources live on the paper branch;
# listed here so a compile from this branch cannot stage them by accident.
latex_paper/*.aux
latex_paper/*.bbl
latex_paper/*.blg
latex_paper/*.log
latex_paper/*.out
latex_paper/*.pdf
latex_paper/*.spl
latex_paper/*.synctex.gz
latex_paper/*.toc
latex_paper/**/*.aux
latex_paper/**/*.log
latex_paper/figures/

# Snapshots of models_v3/ kept for comparison across a change, such as
# models_v3_before_level_fix/. Same reason as models_v3/ itself: large, and
# regenerable in principle. Wildcarded so renaming a snapshot cannot silently
# put 2.8 GB back in front of git.
models_v3_*/

# Machine-specific R environment settings, notably the reticulate Python pin.
.Renviron

# Portfolio backtest objects (~1.6 GB, single files up to ~345 MB, above
# GitHub's 100 MB limit). Regenerated by the portfolio pipeline and backed up
# to external object storage instead of git history.
ports/

# Machine-readable result dumps behind the manuscript tables (~535 MB). The
# rendered .tex tables and appendices next to them stay tracked; these CSV/RDS
# inputs are regenerated by the reporting scripts and stored externally.
latex_paper/results_v3/1927/data/
latex_paper/results_v3/1986/data/
